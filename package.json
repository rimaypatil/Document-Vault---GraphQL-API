{
  "name": "document-vault-graphql-api",
  "version": "1.0.0",
  "description": "Document Vault GraphQL API backend built with Bun, TypeScript, GraphQL Yoga, PostgreSQL, and Prisma.",
  "module": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "gendb": "prisma migrate deploy && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.10.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "^6.4.0",
    "typescript": "^5.7.0"
  }
}
